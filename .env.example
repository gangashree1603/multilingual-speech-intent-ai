# --- AI provider (server-side only) ---
AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5     # model id for your provider
# AI_BASE_URL=                 # optional override (OpenAI-compatible gateways)

# --- GitHub OAuth App (https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/github/callback
GITHUB_SCOPE=repo              # use public_repo if you only publish public repos

# --- App ---
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=                # long random string: python -c "import secrets;print(secrets.token_hex(32))"
COOKIE_SECURE=false            # set true behind HTTPS
